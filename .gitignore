# Secrets — NEVER commit these
.env
*.env
!.env.example
# Android release signing — NEVER commit
android/key.properties
**/*.jks
**/*.keystore
services/ytdlp/*cookies*.txt
**/ig_cookies.txt
**/tt_cookies.txt

# Python (yt-dlp service)
__pycache__/
*.py[cod]
.venv/
venv/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android / Gradle build artifacts
**/build/
/android/build/
/android/.gradle/
/android/app/debug
/android/app/profile
/android/app/release
